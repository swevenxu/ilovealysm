# Supabase Configuration
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# LLM — Groq (primary, fast inference)
# Get from: https://console.groq.com/keys
# Free tier: 30 req/min, 6,000 tokens/min, 14,400 req/day
GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM — Google Gemini (fallback)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza_your_gemini_api_key_here

# LLM - OpenRouter free model (primary)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free

# Python Extractor Service
# URL where the Python FastAPI extractor service is running
PYTHON_EXTRACTOR_URL=http://localhost:8000
